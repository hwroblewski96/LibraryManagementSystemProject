@model IEnumerable<LibraryManagementSystem.Models.Loan>

@{
    ViewData["Title"] = "Wypożyczenia";
}

<h1>Wypożyczenia</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj wypożyczenie</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Książka</th>
            <th>ID egzemplarza</th>
            <th>Czytelnik</th>
            <th>Data wypożyczenia</th>
            <th>Termin zwrotu</th>
            <th>Data zwrotu</th>
            <th>Status</th>
            <th>Akcje</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.BookCopy?.Book?.Tytul
                </td>

                <td>
                    @item.BookCopyId
                </td>

                <td>
                    @item.Czytelnik
                </td>

                <td>
                    @item.DataWypozyczenia.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </td>

                <td>
                    @item.TerminZwrotu.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </td>

                <td>
                    @if (item.DataZwrotu == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.DataZwrotu.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    }
                </td>

                <td>
                    @if (item.DataZwrotu == null)
                    {
                        <span class="badge bg-warning text-dark">Wypożyczona</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Zwrócona</span>
                    }
                </td>

                <td>
                    @if (item.DataZwrotu == null)
                    {
                        <form asp-action="Return"
                              asp-route-id="@item.Id"
                              method="post"
                              style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">
                                Zwróć
                            </button>
                        </form>
                    }

                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">
                        Szczegóły
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                        Usuń
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>