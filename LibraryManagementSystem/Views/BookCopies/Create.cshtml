@model LibraryManagementSystem.Models.BookCopy

@{
    ViewData["Title"] = "Dodaj egzemplarz";
}

<h1>Dodaj egzemplarz</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="BookId" class="control-label"></label>
                <select asp-for="BookId"
                        class="form-control"
                        asp-items="ViewBag.BookId">
                    <option value="">-- wybierz książkę --</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Dodaj egzemplarz" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}