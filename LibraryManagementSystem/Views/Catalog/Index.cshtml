@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Katalog książek";
}

<h1>Katalog książek</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Tytuł</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Dostępne egzemplarze</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var liczbaDostepnych = item.Egzemplarze?.Count(e => e.Dostepny) ?? 0;
            var liczbaWszystkich = item.Egzemplarze?.Count ?? 0;

            <tr>
                <td>@item.Tytul</td>
                <td>@item.Autor</td>
                <td>@item.ISBN</td>

                <td>
                    @liczbaDostepnych / @liczbaWszystkich
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-primary btn-sm">
                        Szczegóły
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>